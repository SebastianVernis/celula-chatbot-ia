# Cloudflare Pages Headers
# Configuración de cache y optimización para Grupo Musical La Célula

# Cache para assets estáticos - 1 año
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Cache para imágenes WebP - 1 año
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Cache para videos - 1 año
/*.webm
  Cache-Control: public, max-age=31536000, immutable

# Cache para JavaScript y CSS minificados - 1 año
/*.min.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.min.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Cache para fuentes - 1 año
/*.woff
  Cache-Control: public, max-age=31536000, immutable
  
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML - sin cache para siempre tener la versión más reciente
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Página principal
/
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# Service Worker - cache corto
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Manifest PWA
/manifest.json
  Cache-Control: public, max-age=86400

# JSON data files - 1 hora
/assets/data/*.json
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

# Compresión automática
/*
  X-Content-Type-Options: nosniff
