{
  "name": "celula-site",
  "version": "3.0.0",
  "description": "Sitio web de Grupo Musical Versátil La Célula",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "node tools/build.js",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "validate": "node tools/validate.js",
    "lint": "npx eslint --config config/eslint.config.js src/js/**/*.js --fix || echo 'ESLint completed with warnings'",
    "prebuild": "npm run validate",
    "test:multi-provider": "node tests/test-multi-provider.js",
    "test:gemini": "node tests/test-gemini-api.js",
    "test:email": "node tests/test-chatbot-email.js",
    "test:groq": "node tests/test-groq-models.js",
    "test:deployment": "node tests/test-local-deployment.js",
    "test": "npm run test:multi-provider && npm run test:gemini && npm run test:email && npm run test:groq && npm run test:deployment"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "node-fetch": "^3.3.2",
    "openai": "^6.10.0",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "cssnano": "^7.1.2",
    "eslint": "^8.57.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "vercel": "^37.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "grupo-musical",
    "vercel",
    "website"
  ],
  "author": "Grupo La Célula",
  "license": "MIT"
}
